DirectoryIndex index.php index.html

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── Pass request headers through Apache (Hostinger strips them by default) ──
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization},E=HTTP_X_HTTP_METHOD_OVERRIDE:%{HTTP:X-HTTP-Method-Override}]

  # Block access to sensitive directories
  RewriteRule ^data/  - [F,L]
  RewriteRule ^\\.     - [F,L]

  # Redirect legacy taxonomy, translated, and package routes before the SPA fallback.
  RewriteRule ^contact/?$ /legacy-redirect.php?target=L2NvbnRhY3Qv2LTYsdmD2Kkt2KrZhti42YrZgS3YqNin2YTYsdmK2KfYtg [END]
  RewriteRule ^faq/?$ /legacy-redirect.php?target=L2ZhcS_YqtmG2LjZitmBLdin2YTZhdmG2KfYstmELdio2KfZhNix2YrYp9i2 [END]
  RewriteRule ^cleaning-packages/تنظيف-بعد-التشطيب-بالرياض/?$ cleaning-packages/تنظيف-بعد-التشطيب-بالرياض/index.php [END]
  RewriteRule ^cleaning-packages/تنظيف-واجهات-مباني-بالرياض/?$ cleaning-packages/تنظيف-واجهات-مباني-بالرياض/index.php [END]
  RewriteRule ^cleaning-packages/تركيب-أنظمة-حريق-بالرياض/?$ cleaning-packages/تركيب-أنظمة-حريق-بالرياض/index.php [END]
  RewriteRule ^من-نحن/?$ /about [R=301,L]
  RewriteRule ^اتصل-بنا/?$ /legacy-redirect.php?target=L2NvbnRhY3Qv2LTYsdmD2Kkt2KrZhti42YrZgS3YqNin2YTYsdmK2KfYtg [END]
  RewriteRule ^اتصل-الآن/?$ /call-now [R=301,L]
  RewriteRule ^الأسئلة-الشائعة/?$ /legacy-redirect.php?target=L2ZhcS_YqtmG2LjZitmBLdin2YTZhdmG2KfYstmELdio2KfZhNix2YrYp9i2 [END]
  RewriteRule ^سياسة-الخصوصية/?$ /privacy [R=301,L]
  RewriteRule ^الشروط-والأحكام/?$ /terms [R=301,L]
  RewriteRule ^المدونة/?$ /blog [R=301,L]
  RewriteRule ^المدونة/([^/]+)/?$ /blog/$1 [R=301,L,B]
  RewriteRule ^العروض/?$ /offers [R=301,L]
  RewriteRule ^المناطق/?$ /areas [R=301,L]
  RewriteRule ^الأسعار/?$ /cleaning-packages [R=301,L]
  RewriteRule ^packages/?$ /cleaning-packages [R=301,L]
  RewriteRule ^خدماتنا/([^/]+)/?$ /services/$1 [R=301,L,B]
  RewriteRule ^الأحياء/([^/]+)/?$ /areas/$1 [R=301,L,B]
  RewriteRule ^مقالات-السهم/?$ /blog [R=301,L]
  RewriteRule ^خدماتنا-بالرياض/خدمات-اخرى/?$ /services [R=301,L]
  RewriteRule ^تنظيف-الكنب-بالرياض-مع-التعطيروالتجف/?$ /legacy-redirect.php?target=L3NlcnZpY2VzL9i62LPZitmELdmF2KzYp9mE2LMt2KjYp9mE2KjYrtin2LEt2KjYp9mE2LHZitin2LY [END]
