    "بيانات\\s*(?:ال)?تقرير\\s*(?:ال)?فني\\s*للمنش(?:أة|آت)",
    "بيانات\\s*ملف\\s*السلامة\\s*للمنشأة",
    "سجل\\s*زيارات\\s*صيانة\\s*(?:أنظمة\\s*)?السلامة",
