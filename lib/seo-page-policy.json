  "rankMath": {
    "engine": "Project-owned Rank Math-style SEO quality gate (not the official WordPress plugin)",
    "version": 2,
    "minimumPublishScore": 80,
    "title": {
      "minimum": 30,
      "targetMinimum": 50,
      "maximum": 60,
      "hardMaximum": 70
    },
    "description": {
      "minimum": 120,
      "maximum": 160,
      "hardMaximum": 200
    },
    "minimumWords": {
      "homepage": 60,
      "service": 30,
      "package": 30,
      "article": 300,
      "landing": 150,
      "area": 50,
      "static": 50
    },
    "checks": {
      "title": 12,
      "titleLength": 5,
      "keyword": 5,
      "keywordTitle": 10,
      "description": 10,
      "descriptionLength": 5,
      "keywordDescription": 5,
      "h1": 8,
      "keywordH1": 8,
      "keywordIntroduction": 6,
      "contentDepth": 10,
      "slug": 5,
      "keywordUrl": 4,
      "canonical": 8,
      "imageAlt": 4,
      "internalLinks": 3,
      "schema": 2
    }
  }
