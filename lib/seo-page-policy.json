    "مكيفات[\\s\\S]{0,30}مستعمل",
    "مستعمل[\\s\\S]{0,30}مكيفات"
  ],
  "supportedServiceTopicPatterns": [
    "تنظيف",
    "نظافة",
    "غسيل",
    "جلي",
    "تلميع",
    "تعقيم",
    "مكافحة",
